<div class="mx-auto max-w-5xl">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold text-white">Series Watch</h1>
      <p class="mt-2 text-sm text-gray-400">
        Hardcover audiobook series are watched by default when you request them. Turn off any series you do not want monitored.
      </p>
    </div>
    <div class="text-sm text-gray-400">
      <%= @watched_series.count(&:enabled?) %> watched · <%= @watched_series.size %> total
    </div>
  </div>

  <% unless SettingsService.get(:hardcover_series_watch_enabled, default: true) %>
    <div class="mb-6 rounded-lg border border-amber-500/30 bg-amber-500/10 p-4 text-sm text-amber-200">
      Global Hardcover series watching is disabled in Settings. Per-series switches are saved, but automatic checks will not run until the global setting is enabled.
    </div>
  <% end %>

  <% if @watched_series.empty? %>
    <div class="rounded-lg border border-gray-800 bg-gray-900 p-8 text-center">
      <p class="text-gray-300">No series have been added to the watch list yet.</p>
      <p class="mt-2 text-sm text-gray-500">Request a Hardcover audiobook series and it will appear here automatically.</p>
    </div>
  <% else %>
    <div class="space-y-4">
      <% @watched_series.each do |series| %>
        <div class="rounded-lg border border-gray-800 bg-gray-900 p-5">
          <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="truncate text-lg font-semibold text-white"><%= series.title %></h2>
                <span class="rounded-full px-2 py-0.5 text-xs font-medium <%= series.enabled? ? 'bg-emerald-500/15 text-emerald-300' : 'bg-gray-700 text-gray-300' %>">
                  <%= series.enabled? ? "Watching" : "Off" %>
                </span>
              </div>
              <p class="mt-1 text-xs text-gray-500">Hardcover series <%= series.collection_id %></p>
              <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs text-gray-400">
                <span>Last checked: <%= series.last_checked_at ? time_ago_in_words(series.last_checked_at) + " ago" : "Never" %></span>
                <span>Last success: <%= series.last_success_at ? time_ago_in_words(series.last_success_at) + " ago" : "Never" %></span>
              </div>
              <% if series.last_error.present? %>
                <p class="mt-2 break-words text-xs text-red-300">Last error: <%= series.last_error %></p>
              <% end %>
            </div>

            <div class="flex shrink-0 flex-wrap gap-2">
              <% if series.enabled? %>
                <%= button_to "Check now", refresh_watched_series_path(series), method: :post, class: "rounded-md bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-500" %>
              <% end %>

              <%= form_with model: series, url: watched_series_path(series), method: :patch do |form| %>
                <%= form.hidden_field :enabled, value: (!series.enabled?).to_s %>
                <%= form.submit(series.enabled? ? "Stop watching" : "Start watching",
                  class: "rounded-md px-3 py-2 text-sm font-medium transition cursor-pointer #{series.enabled? ? 'bg-gray-700 text-gray-200 hover:bg-gray-600' : 'bg-emerald-600 text-white hover:bg-emerald-500'}") %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
